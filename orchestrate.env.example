# Copy to your repo root as `.orchestrate.env` and fill in what applies.
# Every field is OPTIONAL — the skill works with none of them and gets sharper with each one.
# 复制到项目根目录改名为 .orchestrate.env；全部可选，填一条准一条。

TEST_CMD=""            # targeted acceptance command — set this one first
                       #   e.g. "python -m pytest tests/unit -q" | "cargo test -q" | "npm test"
REQUIRED_ENV=""        # env var names the work and any submitted job must export (space separated)
SUBMODULES=""          # submodule paths needing a gitlink gate; empty = auto-detect from .gitmodules
NOTES_FILE=""          # project notes/log the worker appends each milestone to, e.g. "docs/worklog.md"

# --- scheduler / long-running layer: leave empty on a laptop, the skill skips it entirely ---
SCHED_LIST_CMD=""      # lists your jobs, one line per job: "<nodes> <name> <state>"
                       #   slurm: squeue -u $USER -h -o "%D %j %T"
                       #   pbs:   qstat -u $USER | awk 'NR>5 {print 1, $4, $10}'
                       #   lsf:   bjobs -u $USER -noheader -o "min_req_proc job_name stat"
MAX_BIG_JOBS=1         # concurrent multi-node / expensive jobs allowed
EXTRA_SUBMIT_ARGS=""   # args appended to every submit, e.g. "--exclude=node[07,12]"
QUOTA_CMD=""           # e.g. "df -h $HOME" | "lfs quota -hu $USER $HOME" | "quota -s"
