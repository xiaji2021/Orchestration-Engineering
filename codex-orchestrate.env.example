# 复制到项目根目录并改名为 .codex-orchestrate.env（通用版：任何主机/集群）
SUBMODULES=""            # 需要 gitlink 门禁的子模块名，空格分隔；无则留空
REQUIRED_ENV=""          # 委派与作业必须导出的环境变量名
SCHED_LIST_CMD=""        # 列出本人作业的命令，输出每行 "<节点数> <名称> <状态>"；无调度器留空
                         #   slurm 例: squeue -u $USER -h -o "%D %j %T"    pbs 例: qstat -u $USER (自行格式化)
MAX_BIG_JOBS=1           # 同时允许的大作业数（节点数>1 视为大作业）
EXTRA_SUBMIT_ARGS=""     # 提交作业固定附加参数（如排除坏节点），可空
QUOTA_CMD=""             # 查配额的命令（如 "df -h $HOME" / "lfs quota -hu $USER $HOME"），可空
TEST_CMD="python -m pytest tests -q"   # 定向测试命令
