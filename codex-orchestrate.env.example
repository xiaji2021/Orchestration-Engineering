# 复制到你的项目根目录并改名为 .codex-orchestrate.env
SUBMODULES=""            # 需要 gitlink 门禁的子模块名，空格分隔；无则留空
REQUIRED_ENV=""          # 委派与作业必须导出的环境变量名，如 "MY_LIB_ROOT PYTHONPATH"
SCHEDULER="slurm"        # slurm | none
MAX_MULTINODE_JOBS=1     # 同时允许的多节点大作业数
EXCLUDE_NODES=""         # 已知坏节点，空格分隔
TEST_CMD="python -m pytest tests -q"   # 定向测试命令
# CSCC 示例值：
# SCHEDULER="slurm"; EXCLUDE_NODES="gpumid-20 gpumid-48 gpuhigh-07"; MAX_MULTINODE_JOBS=1
